# Django Settings
SECRET_KEY=your-super-secret-django-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.railway.app,.onrender.com

# PostgreSQL Database (Docker or Cloud)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/llm_devops_db

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Jenkins Configuration
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=your-jenkins-api-token-here

# Django REST API Token (Used by Jenkins to post build logs back to Django)
DJANGO_API_TOKEN=your-django-rest-auth-token-here