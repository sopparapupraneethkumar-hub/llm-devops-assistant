pipeline {

    agent any

    environment {
        BUILD_RESULT = "SUCCESS"
    }

    stages {

        stage('Setup Python Environment') {
            steps {
                sh '''
                    python3 -m venv .venv
                    . .venv/bin/activate

                    python -m pip install --upgrade pip

                    cd backend
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Verify Django Project') {
            steps {
                script {
                    try {

                        sh '''
                            . .venv/bin/activate

                            cd backend

                            python manage.py check
                        '''

                        env.BUILD_RESULT = "SUCCESS"

                    } catch(Exception e) {

                        env.BUILD_RESULT = "FAILED"

                        throw e
                    }
                }
            }
        }

        stage('Verify send_build.py') {
            steps {
                sh '''
                    cd backend

                    echo "===== send_build.py ====="

                    cat scripts/send_build.py

                    echo "========================="
                '''
            }
        }

    }
    post {

    always {

        script {

            def durationSeconds = (currentBuild.duration / 1000) as Integer

            withCredentials([
                usernamePassword(
                    credentialsId: 'jenkins-api',
                    usernameVariable: 'JENKINS_USERNAME',
                    passwordVariable: 'JENKINS_API_TOKEN'
                )
            ]) {

                withEnv([

                    "BUILD_NUMBER=${env.BUILD_NUMBER}",
                    "JOB_NAME=${env.JOB_NAME}",
                    "BRANCH_NAME=${env.GIT_BRANCH ?: 'main'}",
                    "BUILD_STATUS=${env.BUILD_RESULT}",
                    "BUILD_DURATION=${durationSeconds}",
                    "API_URL=http://host.docker.internal:8000/api/builds/",
                    "JENKINS_URL=http://localhost:8080",

                ]) {

                    sh '''

                        . .venv/bin/activate

                        cd backend

                        echo "=============================="
                        echo "BUILD_NUMBER=$BUILD_NUMBER"
                        echo "JOB_NAME=$JOB_NAME"
                        echo "BUILD_STATUS=$BUILD_STATUS"
                        echo "BRANCH_NAME=$BRANCH_NAME"
                        echo "BUILD_DURATION=$BUILD_DURATION"
                        echo "JENKINS_URL=$JENKINS_URL"
                        echo "JENKINS_USERNAME=$JENKINS_USERNAME"
                        echo "TOKEN_LENGTH=${#JENKINS_API_TOKEN}"
                        echo "=============================="

                        python scripts/send_build.py

                    '''

                }

            }

        }

    }

}
